  // No reminders
  if (totalReminders == 0) {

    u8g2.drawStr(32, 32, "No Reminders");
    u8g2.drawStr(18, 52, "LEFT: Back");

    u8g2.sendBuffer();
    return;
  }

  // Show up to 3 reminders
  const int VISIBLE_ITEMS = 3;

  if (reminder_menu_selected < reminder_menu_scroll) {
    reminder_menu_scroll = reminder_menu_selected;
  }

  if (reminder_menu_selected >= reminder_menu_scroll + VISIBLE_ITEMS) {
    reminder_menu_scroll =
      reminder_menu_selected - VISIBLE_ITEMS + 1;
  }

  int endItem = reminder_menu_scroll + VISIBLE_ITEMS;

  if (endItem > totalReminders) {
    endItem = totalReminders;
  }

  int y = 20;

  for (int menuIndex = reminder_menu_scroll;
       menuIndex < endItem;
       menuIndex++) {

    int arrayIndex = getReminderArrayIndex(menuIndex);

    if (arrayIndex == -1) {
      continue;
    }

    // Selected reminder
    if (menuIndex == reminder_menu_selected) {

      u8g2.drawRBox(1, y - 9, 126, 15, 2);

      u8g2.setDrawColor(0);
    }

    char timeText[10];

    snprintf(
      timeText,
      sizeof(timeText),
      "%02d:%02d",
      reminders[arrayIndex].hour,
      reminders[arrayIndex].minute
    );

    u8g2.drawStr(5, y, timeText);

    // Shorten text for OLED
    String displayText = reminders[arrayIndex].text;

    if (displayText.length() > 14) {
      displayText = displayText.substring(0, 14);
    }

    u8g2.drawStr(
      38,
      y,
      displayText.c_str()
    );

    if (menuIndex == reminder_menu_selected) {
      u8g2.setDrawColor(1);
    }

    y += 16;
  }

  // Bottom instructions
  u8g2.setFont(u8g2_font_5x7_tr);

  u8g2.drawStr(3, 63, "SEL: Clear");

  u8g2.drawStr(80, 63, "LEFT: Back");

  u8g2.sendBuffer();
}
// -------------------- SETUP --------------------

void setup() {
  Serial.begin(115200);

  // Classic ESP32 I2C pins:
  Wire.begin(21, 22);

  u8g2.begin();
  u8g2.setDrawColor(1);
  u8g2.setBitmapMode(1);

  pinMode(BUTTON_UP_PIN, INPUT_PULLUP);
  pinMode(BUTTON_SELECT_PIN, INPUT_PULLUP);
  pinMode(BUTTON_DOWN_PIN, INPUT_PULLUP);
  pinMode(BUTTON_LEFT_PIN, INPUT_PULLUP);
  pinMode(BUTTON_RIGHT_PIN, INPUT_PULLUP);
  pinMode(BUTTON_BACK_PIN, INPUT_PULLUP);;
  pinMode(BUZZER_PIN, OUTPUT);

    // Seed RNG via floating analog pin
  randomSeed(analogRead(RANDOM_SEED_PIN));

  client.setInsecure();

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to WiFi");

  // Do not block the entire device forever if WiFi is unavailable.
  unsigned long wifiStart = millis();
  const unsigned long WIFI_TIMEOUT = 15000;

  while (WiFi.status() != WL_CONNECTED &&
         millis() - wifiStart < WIFI_TIMEOUT) {
    delay(250);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("WiFi connected!");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("WiFi connection timeout.");
    Serial.println("Device will continue offline.");
  }

  setupReminderSystem(); // starts NTP sync for the reminder clock

  // Create synchronization objects before starting background tasks.
  reminderMutex = xSemaphoreCreateMutex();
  telegramMutex = xSemaphoreCreateMutex();

  // Telegram network work is isolated from the fast UI loop.
  xTaskCreatePinnedToCore(
    reminderTask, "ReminderTask", 8192, NULL, 1, &reminderTaskHandle, 0
  );

  xTaskCreatePinnedToCore(
    telegramTask, "TelegramTask", 8192, NULL, 1, &telegramTaskHandle, 0
  );

  drawMainMenu();
}

// -------------------- MAIN MENU --------------------

void handleMainMenu() {
  if (digitalRead(BUTTON_UP_PIN) == LOW && button_up_clicked == 0) {
    button_up_clicked = 1;
    item_selected--;
    if (item_selected < 0) item_selected = NUM_ITEMS - 1;
    tone(BUZZER_PIN, 880, 50);
  }

  if (digitalRead(BUTTON_UP_PIN) == HIGH) {
    button_up_clicked = 0;
  }

  if (digitalRead(BUTTON_DOWN_PIN) == LOW && button_down_clicked == 0) {
    button_down_clicked = 1;
    item_selected++;
    if (item_selected >= NUM_ITEMS) item_selected = 0;
    tone(BUZZER_PIN, 440, 50);
  }

  if (digitalRead(BUTTON_DOWN_PIN) == HIGH) {
    button_down_clicked = 0;
  }

  if (digitalRead(BUTTON_SELECT_PIN) == LOW &&
      button_select_clicked == 0) {

    button_select_clicked = 1;
    tone(BUZZER_PIN, 1200, 150);

    if (item_selected == 0) {
      current_screen = 1;
      game_current_screen = 0;
      game_item_selected = 0;
      resetInputFlags();
      game_button_select_clicked = 1;
    }
    else if (item_selected == 1) {
      current_screen = 2;
      yoga_current_screen = 0;
      yoga_item_selected = 0;
      resetInputFlags();
      yoga_button_select_clicked = 1;
    }
    else if (item_selected == 2) {

  current_screen = 4;

  reminder_menu_selected = 0;
  reminder_menu_scroll = 0;

  resetInputFlags();

  reminder_button_select_clicked = 1;
}
    else if (item_selected == 3) {
      current_screen = 3;
      selected = 0;
      resetInputFlags();
      eg_button_select_clicked = 1;
    }
  }

  if (digitalRead(BUTTON_SELECT_PIN) == HIGH) {
    button_select_clicked = 0;
  }

  drawMainMenu();
}

void handleReminderMenu() {

  int totalReminders = getReminderMenuCount();

  // If there are no reminders
  if (totalReminders == 0) {

    reminder_menu_selected = 0;
    reminder_menu_scroll = 0;

  } else {

    // ---------------- UP ----------------
    if (digitalRead(BUTTON_UP_PIN) == LOW &&
        reminder_button_up_clicked == 0) {

      reminder_button_up_clicked = 1;

      reminder_menu_selected--;

      if (reminder_menu_selected < 0) {
        reminder_menu_selected = totalReminders - 1;
      }

      tone(BUZZER_PIN, 880, 50);
    }

    if (digitalRead(BUTTON_UP_PIN) == HIGH) {
      reminder_button_up_clicked = 0;
    }


    // ---------------- DOWN ----------------
    if (digitalRead(BUTTON_DOWN_PIN) == LOW &&
        reminder_button_down_clicked == 0) {

      reminder_button_down_clicked = 1;

      reminder_menu_selected++;

      if (reminder_menu_selected >= totalReminders) {
        reminder_menu_selected = 0;
      }

      tone(BUZZER_PIN, 440, 50);
    }

    if (digitalRead(BUTTON_DOWN_PIN) == HIGH) {
      reminder_button_down_clicked = 0;
    }


    // ---------------- SELECT = CLEAR ----------------
    if (digitalRead(BUTTON_SELECT_PIN) == LOW &&
        reminder_button_select_clicked == 0) {

      reminder_button_select_clicked = 1;

      int arrayIndex =
        getReminderArrayIndex(reminder_menu_selected);

      if (arrayIndex != -1) {

        if (reminderMutex) {
          xSemaphoreTake(
            reminderMutex,
            portMAX_DELAY
          );
        }

        reminders[arrayIndex].active = false;
        reminders[arrayIndex].used = false;
        reminders[arrayIndex].text = "";

        if (reminderMutex) {
          xSemaphoreGive(reminderMutex);
        }

        tone(BUZZER_PIN, 1200, 100);

        // Correct selected position
        totalReminders = getReminderMenuCount();

        if (reminder_menu_selected >= totalReminders &&
            totalReminders > 0) {

          reminder_menu_selected =
            totalReminders - 1;
        }

        if (totalReminders == 0) {
          reminder_menu_selected = 0;
          reminder_menu_scroll = 0;
        }
      }
    }

    if (digitalRead(BUTTON_SELECT_PIN) == HIGH) {
      reminder_button_select_clicked = 0;
    }
  }


  // ---------------- LEFT = BACK ----------------
  if (digitalRead(BUTTON_BACK_PIN) == LOW &&
      reminder_button_left_clicked == 0) {

    reminder_button_left_clicked = 1;

    current_screen = 0;

    resetInputFlags();

    tone(BUZZER_PIN, 800, 80);

    return;
  }

  if (digitalRead(BUTTON_BACK_PIN) == HIGH) {
    reminder_button_left_clicked = 0;
  }


  drawReminderMenu();
}

// -------------------- GAME SUBMENU --------------------

void handleGameMenu() {

  // If we're actually inside Game 1, run its own state machine
  // and handle LEFT (back to game menu) here, then bail out.
  if (game_current_screen == 1) {
    if (digitalRead(BUTTON_BACK_PIN) == LOW && game_button_left_clicked == 0) {
      game_button_left_clicked = 1;
      game_current_screen = 0;   // back to game menu, not main menu
      tone(BUZZER_PIN, 800, 80);
      return;
    }
    if (digitalRead(BUTTON_BACK_PIN) == HIGH) {
      game_button_left_clicked = 0;
    }

    Game1();
    return;
  }

  if (game_current_screen == 2) {
    if (digitalRead(BUTTON_BACK_PIN) == LOW && game_button_left_clicked == 0) {
      game_button_left_clicked = 1;
      game_current_screen = 0;   // back to game menu, not main menu
      tone(BUZZER_PIN, 800, 80);
      return;
    }
    if (digitalRead(BUTTON_BACK_PIN) == HIGH) {
      game_button_left_clicked = 0;
    }

    Game2();
    return;
  }

    if (game_current_screen == 3) {
    if (digitalRead(BUTTON_BACK_PIN) == LOW && game_button_left_clicked == 0) {
      game_button_left_clicked = 1;
      game_current_screen = 0;   // back to game menu, not main menu
      tone(BUZZER_PIN, 800, 80);
      return;
    }
    if (digitalRead(BUTTON_BACK_PIN) == HIGH) {
      game_button_left_clicked = 0;
    }

    Game3();
    return;
  }
  // ---- game_current_screen == 0: show the Game 1/2/3 select menu ----

  if (digitalRead(BUTTON_UP_PIN) == LOW && game_button_up_clicked == 0) {
    game_button_up_clicked = 1;
    game_item_selected--;
    if (game_item_selected < 0) game_item_selected = GAME_NUM_ITEMS - 1;
    tone(BUZZER_PIN, 880, 50);
  }
  if (digitalRead(BUTTON_UP_PIN) == HIGH) game_button_up_clicked = 0;

  if (digitalRead(BUTTON_DOWN_PIN) == LOW && game_button_down_clicked == 0) {
    game_button_down_clicked = 1;
    game_item_selected++;
    if (game_item_selected >= GAME_NUM_ITEMS) game_item_selected = 0;
    tone(BUZZER_PIN, 440, 50);
  }
  if (digitalRead(BUTTON_DOWN_PIN) == HIGH) game_button_down_clicked = 0;

  if (digitalRead(BUTTON_SELECT_PIN) == LOW && game_button_select_clicked == 0) {
    game_button_select_clicked = 1;
    tone(BUZZER_PIN, 1200, 150);

    if (game_item_selected == 0) {
      game_current_screen = 1;
      currentState = STATE_START;
      currentLevel = 1;
      playIndex = 0;
      cursorIndex = 4;
    }
    else if (game_item_selected == 1) {
      game_current_screen = 2;
      game2SelectReleased = false;
    }
    else if (game_item_selected == 2) {
      game_current_screen = 3;   // Game 3 not implemented yet
      currentState2 = STATE_START2;
      currentLevel2 = 1;
      int patternLength = 3;
      cursorIndex2 = 0;
      needsRedraw = true;
    }
    return; // re-enter next loop() with the new screen already set
  }
  if (digitalRead(BUTTON_SELECT_PIN) == HIGH) game_button_select_clicked = 0;

  if (digitalRead(BUTTON_BACK_PIN) == LOW && game_button_left_clicked == 0) {
    game_button_left_clicked = 1;
    current_screen = 0;
    resetInputFlags();
    tone(BUZZER_PIN, 800, 80);
    return;
  }
  if (digitalRead(BUTTON_BACK_PIN) == HIGH) game_button_left_clicked = 0;

  drawGameMenu();
}
// -------------------- YOGA SUBMENU --------------------
int startTime;
int endTime;
int timeMin;
void handleYogaMenu() {
  if (yoga_current_screen == 0) {

    if (digitalRead(BUTTON_UP_PIN) == LOW &&
        yoga_button_up_clicked == 0) {

      yoga_button_up_clicked = 1;
      yoga_item_selected--;

      if (yoga_item_selected < 0) {
        yoga_item_selected = YOGA_NUM_ITEMS - 1;
      }

      tone(BUZZER_PIN, 880, 50);
    }

    if (digitalRead(BUTTON_UP_PIN) == HIGH) {
      yoga_button_up_clicked = 0;
    }

    if (digitalRead(BUTTON_DOWN_PIN) == LOW &&
        yoga_button_down_clicked == 0) {

      yoga_button_down_clicked = 1;
      yoga_item_selected++;

      if (yoga_item_selected >= YOGA_NUM_ITEMS) {
        yoga_item_selected = 0;
      }

      tone(BUZZER_PIN, 440, 50);
    }

    if (digitalRead(BUTTON_DOWN_PIN) == HIGH) {
      yoga_button_down_clicked = 0;
    }

    if (digitalRead(BUTTON_SELECT_PIN) == LOW &&
        yoga_button_select_clicked == 0) {

      yoga_button_select_clicked = 1;
      tone(BUZZER_PIN, 1200, 150);

      // Each yoga item gets its own screen.
      if (yoga_item_selected == 0) {
        yoga_current_screen = 1;   // Yoga 1
      }
      else if (yoga_item_selected == 1) {
        yoga_current_screen = 2;   // Yoga 2
      }
      else {
        yoga_current_screen = 3;   // Yoga 3
      }

      startTime = millis();
      // Start Yoga 1 animation from the first frame.
      currentFrame = 0;
      lastFrameTime = millis();
    }

    if (digitalRead(BUTTON_SELECT_PIN) == HIGH) {
      yoga_button_select_clicked = 0;
    }

    // LEFT from Yoga menu -> main menu
    if (digitalRead(BUTTON_BACK_PIN) == LOW &&
        yoga_button_left_clicked == 0) {

      yoga_button_left_clicked = 1;
      current_screen = 0;
      yoga_current_screen = 0;
      resetInputFlags();
      tone(BUZZER_PIN, 800, 80);
      return;
    }

    if (digitalRead(BUTTON_BACK_PIN) == HIGH) {
      yoga_button_left_clicked = 0;
    }

    drawYogaMenu();
    return;
  }

  // -------------------- YOGA IMAGE SCREEN --------------------
  //
  // No blocking while() is used here.
  // The old code entered a blocking loop while LEFT was held,
  // which made navigation unreliable.
  //
  // A SHORT press of LEFT returns to Yoga menu.
  // A LONG press also returns to Yoga menu, but only once.
  // Neither can accidentally jump directly to the main menu.

  if (digitalRead(BUTTON_BACK_PIN) == LOW) {

    if (!leftPressActive) {
      leftPressActive = true;
      leftLongPressHandled = false;
      leftPressStart = millis();
        timeMin = timeMin + (endTime-startTime)/(60*1000);
  bot.sendMessage(
      CHANNEL_ID,"/yoga"+String(yoga_current_screen)+" "+
      String(timeMin),
      ""
    );
    }

    if (!leftLongPressHandled &&
        millis() - leftPressStart >= LONG_PRESS_TIME) {

      leftLongPressHandled = true;
      yoga_current_screen = 0;
      currentFrame = 0;
      lastFrameTime = millis();
      endTime = millis();
      tone(BUZZER_PIN, 800, 100);
      timeMin = timeMin + (endTime-startTime)/(60*1000);
      bot.sendMessage(
      CHANNEL_ID,"/yoga"+String(yoga_current_screen)+" "+
      String(timeMin),
      ""
    );

      // Wait for release without blocking the display loop.
      // The release is handled below.
    }
  }
  else {
    if (leftPressActive) {

      // If it was released before the long-press threshold,
      // treat it as a normal BACK operation.
      if (!leftLongPressHandled) {
        yoga_current_screen = 0;
        currentFrame = 0;
        lastFrameTime = millis();
        tone(BUZZER_PIN, 800, 80);
      }

      leftPressActive = false;
      leftLongPressHandled = false;
    }
  }

  // Draw Yoga 1/2/3.
  //
  // The original file only supplied an animated frame sequence for
  // Yoga 1. Until separate Yoga 2/3 display logic is added, use the
  // same safe screen behavior instead of showing an uninitialized
  // buffer.
  if (yoga_current_screen == 1) {

    if (millis() - lastFrameTime >= FRAME_INTERVAL) {
      lastFrameTime = millis();
      currentFrame = !currentFrame;
    }

    drawYoga1();
  }
  if (yoga_current_screen == 2) {

    if (millis() - lastFrameTime >= FRAME_INTERVAL) {
      lastFrameTime = millis();
      currentFrame = !currentFrame;
    }

    drawYoga2();
  }
    if (yoga_current_screen == 3) {

    if (millis() - lastFrameTime >= FRAME_INTERVAL) {
      lastFrameTime = millis();
      currentFrame = !currentFrame;
    }

    drawYoga3();
  }
}

