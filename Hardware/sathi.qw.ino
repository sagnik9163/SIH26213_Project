void drawGrid(int highlightedTile, bool showCursor) {
  // Scaled for the rectangular 128x64 screen
  const int tileSize = 14;
  const int gap = 2;
  const int startX = 41;
  const int startY = 16;

  for (int i = 0; i < 9; i++) {
    int col = i % 3;
    int row = i / 3;
    int x = startX + col * (tileSize + gap);
    int y = startY + row * (tileSize + gap);

    // Draw the tile itself
    if (i == highlightedTile) {
      u8g2.drawBox(x, y, tileSize, tileSize); // Filled if active
    } else {
      u8g2.drawFrame(x, y, tileSize, tileSize); // Hollow if inactive
    }

    // Draw the player cursor
    if (showCursor && i == cursorIndex) {
      u8g2.drawFrame(x - 2, y - 2, tileSize + 4, tileSize + 4);
    }
  }
}

struct Button {
  const uint8_t pin;
  bool state;
  bool lastState;
  unsigned long lastDebounceTime;
};

Button btnUp     = {BUTTON_UP_PIN, HIGH, HIGH, 0};
Button btnDown   = {BUTTON_DOWN_PIN, HIGH, HIGH, 0};
Button btnLeft   = {BUTTON_LEFT_PIN, HIGH, HIGH, 0};
Button btnRight  = {BUTTON_RIGHT_PIN, HIGH, HIGH, 0};
Button btnSelect = {BUTTON_SELECT_PIN, HIGH, HIGH, 0};

// Non-blocking button check. Returns true ONLY on the falling edge (press).
bool isButtonPressed(Button &b) {
  bool pressed = false;
  int reading = digitalRead(b.pin);
  
  if (reading != b.lastState) {
    b.lastDebounceTime = millis();
  }
  
  if ((millis() - b.lastDebounceTime) > DEBOUNCE_DELAY) {
    if (reading != b.state) {
      b.state = reading;
      // Button is pressed when LOW (assuming INPUT_PULLUP)
      if (b.state == LOW) {
        pressed = true;
      }
    }
  }
  b.lastState = reading;
  return pressed;
}

void generateMathProblem() {
  int op = random(0, 4); // 0:+, 1:-, 2:*, 3:/
  int num1, num2, ans;

  if (op == 0) { // Addition
    num1 = random(1, 10); num2 = random(1, 10);
    ans = num1 + num2;
    sprintf(mathQuestion, "%d + %d = ?", num1, num2);
  } 
  else if (op == 1) { // Subtraction (No negatives allowed)
    num1 = random(1, 10); num2 = random(1, 10);
    if (num1 < num2) { int t = num1; num1 = num2; num2 = t; } // Swap to ensure num1 is bigger
    ans = num1 - num2;
    sprintf(mathQuestion, "%d - %d = ?", num1, num2);
  } 
  else if (op == 2) { // Multiplication
    num1 = random(1, 10); num2 = random(1, 10);
    ans = num1 * num2;
    sprintf(mathQuestion, "%d x %d = ?", num1, num2);
  } 
  else { // Division (Forces perfect integers)
    num2 = random(1, 10); ans = random(1, 10);
    num1 = num2 * ans; 
    sprintf(mathQuestion, "%d / %d = ?", num1, num2);
  }

  // Pre-fill options with a dummy value to avoid duplicate checking bugs
  for (int i = 0; i < 4; i++) {
    mathOptions[i] = -999;
  }

  // Put the real answer in a random slot
  mathCorrectSlot = random(0, 4);
  mathOptions[mathCorrectSlot] = ans;

  // Generate tricky fake answers for the other 3 slots
  for (int i = 0; i < 4; i++) {
    if (i == mathCorrectSlot) continue; // Skip the real answer
    
    int fake;
    bool isUnique;
    do {
      isUnique = true;
      fake = ans + random(-4, 5); // Pick a number mathematically close to the real one
      if (fake < 0) fake = random(0, 20); // Keep fake answers positive
      
      // Ensure this fake doesn't match the real answer or any other fakes we generated
      for (int j = 0; j < 4; j++) {
        if (j != i && mathOptions[j] == fake) {
          isUnique = false;
        }
      }
    } while (!isUnique);
    
    mathOptions[i] = fake;
  }
}

void Game1() {
  switch (currentState) {
    case STATE_START:
      name = "RECALL";
      loading(name,40,25);
      currentLevel = 1;
      sequence[0] = random(0, 9); // Generate first tile
      cursorIndex = 4;            // Reset cursor to middle
      currentState = STATE_WATCH_PHASE;
      break;

    // ------------------------------------------------
    // STATE: WATCH PHASE (ESP32 plays the pattern)
    // ------------------------------------------------
    case STATE_WATCH_PHASE:
      // Note: We use blocking delay() here because inputs SHOULD be ignored
      for (int i = 0; i < currentLevel; i++) {
        // 1. Show highlighted tile
        u8g2.clearBuffer();
        u8g2.setFont(u8g2_font_ncenB08_tr);
        u8g2.drawStr(0, 10, "Watch...");
        u8g2.setCursor(95, 10); u8g2.print("Lvl:"); u8g2.print(currentLevel);
        
        drawGrid(sequence[i], false); // No cursor shown while watching
        u8g2.sendBuffer();
        
        beepTile();
        delay(400); // Duration the tile stays illuminated

        // 2. Turn off highlight for the gap between tiles
        u8g2.clearBuffer();
        u8g2.drawStr(0, 10, "Watch...");
        u8g2.setCursor(95, 10); u8g2.print("Lvl:"); u8g2.print(currentLevel);
        
        drawGrid(-1, false); // -1 means nothing highlighted
        u8g2.sendBuffer();
        
        delay(200); // Gap duration
      }
      
      playIndex = 0; // Reset player progress for their turn
      currentState = STATE_PLAY_PHASE;
      break;

    // ------------------------------------------------
    // STATE: PLAY PHASE (Player inputs the pattern)
    // ------------------------------------------------
    case STATE_PLAY_PHASE:
      // Render Screen
      u8g2.clearBuffer();
      u8g2.setFont(u8g2_font_ncenB08_tr);
      u8g2.drawStr(0, 10, "Your Turn!");
      u8g2.setCursor(95, 10); u8g2.print("Lvl:"); u8g2.print(currentLevel);
      drawGrid(-1, true); // No tile filled, but show cursor
      u8g2.sendBuffer();

      // Handle Input - D-Pad Constraints
      if (isButtonPressed(btnUp) && cursorIndex > 2) {
        cursorIndex -= 3;
      }
      if (isButtonPressed(btnDown) && cursorIndex < 6) {
        cursorIndex += 3;
      }
      if (isButtonPressed(btnLeft) && (cursorIndex % 3) > 0) {
        cursorIndex -= 1;
      }
      if (isButtonPressed(btnRight) && (cursorIndex % 3) < 2) {
        cursorIndex += 1;
      }

      // Handle Input - Selection
      if (isButtonPressed(btnSelect)) {
        // Visual & audio feedback of player's press
        u8g2.clearBuffer();
        u8g2.drawStr(0, 10, "Your Turn!");
        u8g2.setCursor(95, 10); u8g2.print("Lvl:"); u8g2.print(currentLevel);
        drawGrid(cursorIndex, true); // Fill selected tile
        u8g2.sendBuffer();
        
        beepTile();
        delay(200); // Brief visual confirmation pause

        // Game Logic Evaluation
        if (cursorIndex == sequence[playIndex]) {
          // Correct tile selected!
          playIndex++;
          
          if (playIndex == currentLevel) {
            // Level completed successfully!
            beepSuccess();
            delay(300);
            
            // Advance level
            if (currentLevel < MAX_LEVEL) {
              sequence[currentLevel] = random(0, 9); // Add new step
              currentLevel++;
            }
            currentState = STATE_WATCH_PHASE;
            delay(500); // Pause before next sequence
          }
        } else {
          // Wrong tile selected!
          beepGameOver();
          currentState = STATE_GAME_OVER;
        }
      }
      break;

    // ------------------------------------------------
    // STATE: GAME OVER
    // ------------------------------------------------
    case STATE_GAME_OVER:
      u8g2.clearBuffer();
      u8g2.setFont(u8g2_font_ncenB08_tr);

      if (maxcurrentLevel < currentLevel){
         maxcurrentLevel = currentLevel-1;
         bot.sendMessage(CHANNEL_ID, "/game1 Level" + String(maxcurrentLevel),      "");
      }
      
      // Coordinates set for 128x64 screen
      u8g2.drawStr(30, 25, "GAME OVER!");
      
      u8g2.setCursor(20, 45);
      u8g2.print("Reached Lvl: ");
      u8g2.print(currentLevel);
      
      u8g2.sendBuffer();

      // Wait for select to restart the game loop
      if (isButtonPressed(btnSelect)) {
        currentState = STATE_START;
      }
      break;
  }
}

void Game2 () {
  
  switch (currentState1) {

    // ------------------------------------------------
    // STATE: START SCREEN
    // ------------------------------------------------
    case STATE_START1:
  if (needsRedraw) {
    name = "QUICK MATH";
    loading(name,24,25);
    needsRedraw = false;
  }

    mathScore = 0;
    mathCursor = 0;
    generateMathProblem();

    currentState1 = STATE_PLAY1;
    needsRedraw = true;
  
  break;
    // ------------------------------------------------
    // STATE: PLAY PHASE
    // ------------------------------------------------
    case STATE_PLAY1:
      if (needsRedraw) {
        u8g2.clearBuffer();
        
        // 1. Draw Score
        u8g2.setFont(u8g2_font_ncenB08_tr);
        u8g2.setCursor(0, 10); u8g2.print("Score: "); u8g2.print(mathScore);
        
        // 2. Draw Math Question (Auto-centered!)
        u8g2.setFont(u8g2_font_ncenB10_tr); 
        int textWidth = u8g2.getStrWidth(mathQuestion);
        u8g2.setCursor((128 - textWidth) / 2, 28); 
        u8g2.print(mathQuestion);

        // 3. Draw 2x2 Options Grid
        u8g2.setFont(u8g2_font_ncenB08_tr);
        for (int i = 0; i < 4; i++) {
          int boxX = (i % 2 == 0) ? 14 : 74; // Column 1 or Column 2
          int boxY = (i < 2) ? 34 : 49;      // Row 1 or Row 2
          
          // Draw bounding box if cursor is highlighting this option
          if (i == mathCursor) {
            u8g2.drawFrame(boxX, boxY, 40, 14); // 40px wide, 14px tall
          }
          
          // Draw the option text inside the box
          int optWidth = u8g2.getStrWidth(String(mathOptions[i]).c_str());
          u8g2.setCursor(boxX + (40 - optWidth) / 2, boxY + 11); // Center text in box
          u8g2.print(mathOptions[i]);
        }
        
        u8g2.sendBuffer();
        needsRedraw = false;
      }

      // 4. Handle 2x2 Grid Movement
      // mathCursor indices: 0(TL), 1(TR), 2(BL), 3(BR)
      if (isButtonPressed(btnUp) && mathCursor > 1) { 
        mathCursor -= 2; needsRedraw = true; 
      }
      if (isButtonPressed(btnDown) && mathCursor < 2) { 
        mathCursor += 2; needsRedraw = true; 
      }
      if (isButtonPressed(btnLeft) && (mathCursor % 2 != 0)) { 
        mathCursor -= 1; needsRedraw = true; 
      }
      if (isButtonPressed(btnRight) && (mathCursor % 2 == 0)) { 
        mathCursor += 1; needsRedraw = true; 
      }

      // 5. Handle Selection
      if (game2SelectReleased && isButtonPressed(btnSelect)) {

        game2SelectReleased = false;

        if (mathCursor == mathCorrectSlot) {
          // Correct!
          beepTone(1000, 100);
          mathScore++;
          generateMathProblem(); // Instantly create the next level
        } else {
          // Wrong!
          beepGameOver();
          currentState1 = STATE_GAME_OVER1;
        }
        needsRedraw = true;
      }
      // Allow another Select press only after button is released
      if (digitalRead(BUTTON_SELECT_PIN) == HIGH) {
          game2SelectReleased = true;
      }

      break;

    // ------------------------------------------------
    // STATE: GAME OVER
    // ------------------------------------------------
    case STATE_GAME_OVER1:
      if (needsRedraw) {
        u8g2.clearBuffer();
        u8g2.setFont(u8g2_font_ncenB08_tr);
        u8g2.drawStr(30, 25, "GAME OVER!");
        
        u8g2.setCursor(40, 45); 
        u8g2.print("Score: "); 
        u8g2.print(mathScore);
        
        u8g2.sendBuffer();
        needsRedraw = false;
      }

      if (isButtonPressed(btnSelect)) {
        currentState1 = STATE_START1;
        needsRedraw = true;
      }
       if (maxcurrentLevel1 < mathScore){
         maxcurrentLevel1 = mathScore;
         bot.sendMessage(CHANNEL_ID, "/game2 Level" + String(maxcurrentLevel1),      "");
      }
      break;
  }
}

void Game3() {
  switch (currentState2) {

    // ------------------------------------------------
    // STATE 1: START SCREEN
