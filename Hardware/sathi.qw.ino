// Sets up NTP so the ESP32 knows the actual time-of-day, which is
// required to compare against HH:MM reminders. Call once from
// setup(), after WiFi has connected.
void setupReminderSystem() {
  reminderClient.setInsecure();

  // GMT offset in seconds, then daylight-saving offset in seconds.
  // 19800 = +5:30 (India). Change this if the device is used elsewhere.
  configTime(19800, 0, "pool.ntp.org", "time.nist.gov");
}

// Adds a reminder to the first free slot. Silently drops it if the
// list is full (MAX_REMINDERS reached).
void addReminder(int hour, int minute, String text) {

  if (reminderMutex) {
    xSemaphoreTake(reminderMutex, portMAX_DELAY);
  }

  int slot = -1;

  // Find an unused slot
  for (int i = 0; i < MAX_REMINDERS; i++) {

    if (!reminders[i].used) {
      slot = i;
      break;
    }
  }

  if (slot != -1) {

    reminders[slot].hour = hour;
    reminders[slot].minute = minute;
    reminders[slot].text = text;

    reminders[slot].active = true;
    reminders[slot].used = true;

    if (slot >= reminderCount) {
      reminderCount = slot + 1;
    }

    Serial.println("Reminder added:");
    Serial.print(hour);
    Serial.print(":");
    Serial.print(minute);
    Serial.print(" - ");
    Serial.println(text);

  } else {

    Serial.println("Reminder list is full!");

  }

  if (reminderMutex) {
    xSemaphoreGive(reminderMutex);
  }
}

//To count reminder
int getReminderMenuCount() {

  int count = 0;

  if (reminderMutex) {
    xSemaphoreTake(reminderMutex, portMAX_DELAY);
  }

  for (int i = 0; i < MAX_REMINDERS; i++) {

    if (reminders[i].used) {
      count++;
    }
  }

  if (reminderMutex) {
    xSemaphoreGive(reminderMutex);
  }

  return count;
}

//To get actual reminder index
int getReminderArrayIndex(int menuIndex) {

  int count = 0;
  int result = -1;

  if (reminderMutex) {
    xSemaphoreTake(reminderMutex, portMAX_DELAY);
  }

  for (int i = 0; i < MAX_REMINDERS; i++) {

    if (reminders[i].used) {

      if (count == menuIndex) {
        result = i;
        break;
      }

      count++;
    }
  }

  if (reminderMutex) {
    xSemaphoreGive(reminderMutex);
  }

  return result;
}

// Parses "/remind HH:MM some text" into hour, minute, text.
// Returns false (and leaves the outputs untouched) on any bad format.
bool parseReminderCommand(String msg, int &hour, int &minute, String &text) {
  msg.trim();
  if (!msg.startsWith("/remind ")) return false;

  String rest = msg.substring(8); // strip "/remind "
  int colonIdx = rest.indexOf(':');
  int spaceIdx = rest.indexOf(' ');
  if (colonIdx == -1 || spaceIdx == -1 || spaceIdx < colonIdx) return false;

  String hh = rest.substring(0, colonIdx);
  String mm = rest.substring(colonIdx + 1, spaceIdx);
  String remText = rest.substring(spaceIdx + 1);
  remText.trim();

  int h = hh.toInt();
  int m = mm.toInt();

  if (h < 0 || h > 23 || m < 0 || m > 59) return false;
  if (remText.length() == 0) return false;

  hour = h;
  minute = m;
  text = remText;
  return true;
}

// Poll the reminder bot. This function is called only from the background
// FreeRTOS task, so any HTTPS delay cannot block the UI.
void pollReminderBot() {
  if (WiFi.status() != WL_CONNECTED) return;

  int numNewMessages = reminderBot.getUpdates(reminderBot.last_message_received + 1);

  for (int i = 0; i < numNewMessages; i++) {
    String chatId = reminderBot.messages[i].chat_id;
    String text   = reminderBot.messages[i].text;

    int hour, minute;
    String remText;

    if (parseReminderCommand(text, hour, minute, remText)) {
      addReminder(hour, minute, remText);

      char confirmMsg[80];
      snprintf(confirmMsg, sizeof(confirmMsg), "Reminder set for %02d:%02d", hour, minute);
      reminderBot.sendMessage(chatId, confirmMsg, "");
    } else {
      reminderBot.sendMessage(chatId, "Format: /remind HH:MM your text", "");
    }
  }
}

// Background reminder task. It may block on HTTPS, but only this task
// is blocked; the main UI loop remains responsive.
void reminderTask(void *parameter) {
  for (;;) {
    if (WiFi.status() == WL_CONNECTED) {
      pollReminderBot();
    }
    vTaskDelay(pdMS_TO_TICKS(REMINDER_POLL_INTERVAL));
  }
}

// Background emergency Telegram task.
void telegramTask(void *parameter) {
  for (;;) {
    bool doSend = false;
    int msgIndex = 0;

    if (telegramMutex) xSemaphoreTake(telegramMutex, portMAX_DELAY);
    if (telegramSendPending) {
      telegramSendPending = false;
      doSend = true;
      msgIndex = telegramMessageIndex;
    }
    if (telegramMutex) xSemaphoreGive(telegramMutex);

    if (doSend) {
      bool result = false;
      if (WiFi.status() == WL_CONNECTED) {
        result = bot.sendMessage(CHANNEL_ID, messages[msgIndex], "");
      }

      if (telegramMutex) xSemaphoreTake(telegramMutex, portMAX_DELAY);
      telegramSendResult = result;
      telegramSendDone = true;
      if (telegramMutex) xSemaphoreGive(telegramMutex);
    }

    vTaskDelay(pdMS_TO_TICKS(20));
  }
}

// Checks the current time against all active reminders. When one
// matches, it fires the popup + 5s buzzer and deactivates itself
// (one-shot). Requires setupReminderSystem() to have run and NTP to
// have synced at least once; until then time(nullptr) reads as 0 and
// this simply does nothing.
void checkReminders() {
  time_t now = time(nullptr);
  if (now < 1000) return;

  struct tm *t = localtime(&now);
  if (t == nullptr) return;

  int curHour = t->tm_hour;
  int curMinute = t->tm_min;
  String firedText = "";

  if (reminderMutex) xSemaphoreTake(reminderMutex, portMAX_DELAY);

  for (int i = 0; i < MAX_REMINDERS; i++) {

  if (!reminders[i].used) continue;
  if (!reminders[i].active) continue;

    if (reminders[i].hour == curHour && reminders[i].minute == curMinute) {
      reminders[i].active = false;
      firedText = reminders[i].text;
      break;
    }
  }

  if (reminderMutex) xSemaphoreGive(reminderMutex);

  if (firedText.length() > 0) {
    reminderPopupActive = true;
    reminderPopupStart = millis();
    reminderPopupText = firedText;
    tone(BUZZER_PIN, 1500, REMINDER_POPUP_DURATION);
  }
}

// Draws the reminder popup. Deliberately mirrors the look of
// drawEmergencyScreen() so it feels consistent with the rest of the UI.
void drawReminderPopup() {
  u8g2.clearBuffer();

  u8g2.setFont(u8g2_font_6x10_tr);
  u8g2.drawBox(0, 0, 128, 14);
  u8g2.setDrawColor(0);
  u8g2.drawStr(34, 11, "REMINDER");
  u8g2.setDrawColor(1);

  u8g2.drawRFrame(2, 17, 124, 40, 3);

  // Simple word-wrap so longer reminder text is still readable.
  const int maxCharsPerLine = 20;
  String txt = reminderPopupText;
  int lineY = 30;
  while (txt.length() > 0 && lineY < 55) {
    int cut = min((int)txt.length(), maxCharsPerLine);
    String line = txt.substring(0, cut);
    u8g2.drawStr(8, lineY, line.c_str());
    txt = txt.substring(cut);
    lineY += 12;
  }

  u8g2.sendBuffer();
}

