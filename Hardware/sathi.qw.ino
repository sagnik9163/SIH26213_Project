      }
      break;

    // ------------------------------------------------
    // STATE 3: GUESS (Find what changed)
    // ------------------------------------------------
    case STATE_GUESS2:
      if (needsRedraw) {
        u8g2.clearBuffer();
        u8g2.setFont(u8g2_font_ncenB08_tr);
        
        u8g2.setCursor(0, 10); u8g2.print("Lvl: "); u8g2.print(currentLevel2);
