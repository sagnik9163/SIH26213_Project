  if (digitalRead(BUTTON_UP_PIN) == LOW &&
      game_button_up_clicked == 0) {

    game_button_up_clicked = 1;
    game_item_selected--;
    if (game_item_selected < 0) {
      game_item_selected = GAME_NUM_ITEMS - 1;
    }
    tone(BUZZER_PIN, 880, 50);
  }

  if (digitalRead(BUTTON_UP_PIN) == HIGH) {
    game_button_up_clicked = 0;
  }

  if (digitalRead(BUTTON_DOWN_PIN) == LOW &&
      game_button_down_clicked == 0) {

    game_button_down_clicked = 1;
    game_item_selected++;
    if (game_item_selected >= GAME_NUM_ITEMS) {
      game_item_selected = 0;
    }
    tone(BUZZER_PIN, 440, 50);
  }

  if (digitalRead(BUTTON_DOWN_PIN) == HIGH) {
    game_button_down_clicked = 0;
  }

  // SELECT is intentionally not assigned to a game here because
  // the original file contains no Game 1/2/3 implementation.
  // Add each game's function here when those games are available.
  if (digitalRead(BUTTON_SELECT_PIN) == LOW && game_button_select_clicked == 0) {

      game_button_select_clicked = 1;
      tone(BUZZER_PIN, 1200, 150);

      // Each yoga item gets its own screen.
      if (game_item_selected == 0) {
        game_current_screen = 1;   // Yoga 1
      }
      else if (game_item_selected == 1) {
        game_current_screen = 2;   // Yoga 2
      }
      else {
        game_current_screen = 3;   // Yoga 3
      }
    }


  if (digitalRead(BUTTON_LEFT_PIN) == LOW &&
      button_left_clicked == 0) {

    button_left_clicked = 1;
    current_screen = 0;
    resetInputFlags();
    tone(BUZZER_PIN, 800, 80);
    return;
  }

  if (digitalRead(BUTTON_LEFT_PIN) == HIGH) {
    button_left_clicked = 0;
  }

  drawGameMenu();
}

// -------------------- YOGA SUBMENU --------------------

void handleYogaMenu() {
  if (yoga_current_screen == 0) {

    if (digitalRead(BUTTON_UP_PIN) == LOW &&
        yoga_button_up_clicked == 0) {

      yoga_button_up_clicked = 1;
      yoga_item_selected--;

      if (yoga_item_selected < 0) {
        yoga_item_selected = YOGA_NUM_ITEMS - 1;
      }

      tone(BUZZER_PIN, 880, 50);
    }

    if (digitalRead(BUTTON_UP_PIN) == HIGH) {
      yoga_button_up_clicked = 0;
    }

    if (digitalRead(BUTTON_DOWN_PIN) == LOW &&
        yoga_button_down_clicked == 0) {

      yoga_button_down_clicked = 1;
      yoga_item_selected++;

      if (yoga_item_selected >= YOGA_NUM_ITEMS) {
        yoga_item_selected = 0;
      }

      tone(BUZZER_PIN, 440, 50);
    }

    if (digitalRead(BUTTON_DOWN_PIN) == HIGH) {
      yoga_button_down_clicked = 0;
    }

    if (digitalRead(BUTTON_SELECT_PIN) == LOW &&
        yoga_button_select_clicked == 0) {

      yoga_button_select_clicked = 1;
      tone(BUZZER_PIN, 1200, 150);

      // Each yoga item gets its own screen.
      if (yoga_item_selected == 0) {
        yoga_current_screen = 1;   // Yoga 1
      }
      else if (yoga_item_selected == 1) {
        yoga_current_screen = 2;   // Yoga 2
      }
      else {
        yoga_current_screen = 3;   // Yoga 3
      }

      // Start Yoga 1 animation from the first frame.
      currentFrame = 0;
      lastFrameTime = millis();
    }

    if (digitalRead(BUTTON_SELECT_PIN) == HIGH) {
      yoga_button_select_clicked = 0;
    }

    // LEFT from Yoga menu -> main menu
    if (digitalRead(BUTTON_LEFT_PIN) == LOW &&
        yoga_button_left_clicked == 0) {

      yoga_button_left_clicked = 1;
      current_screen = 0;
      yoga_current_screen = 0;
      resetInputFlags();
      tone(BUZZER_PIN, 800, 80);
      return;
    }

    if (digitalRead(BUTTON_LEFT_PIN) == HIGH) {
      yoga_button_left_clicked = 0;
    }

    drawYogaMenu();
    return;
  }

  // -------------------- YOGA IMAGE SCREEN --------------------
  //
  // No blocking while() is used here.
  // The old code entered a blocking loop while LEFT was held,
  // which made navigation unreliable.
  //
  // A SHORT press of LEFT returns to Yoga menu.
  // A LONG press also returns to Yoga menu, but only once.
  // Neither can accidentally jump directly to the main menu.

  if (digitalRead(BUTTON_LEFT_PIN) == LOW) {

    if (!leftPressActive) {
      leftPressActive = true;
      leftLongPressHandled = false;
      leftPressStart = millis();
    }

    if (!leftLongPressHandled &&
        millis() - leftPressStart >= LONG_PRESS_TIME) {

      leftLongPressHandled = true;
      yoga_current_screen = 0;
      currentFrame = 0;
      lastFrameTime = millis();

      tone(BUZZER_PIN, 800, 100);

      // Wait for release without blocking the display loop.
      // The release is handled below.
    }
  }
  else {
    if (leftPressActive) {

      // If it was released before the long-press threshold,
      // treat it as a normal BACK operation.
      if (!leftLongPressHandled) {
        yoga_current_screen = 0;
        currentFrame = 0;
        lastFrameTime = millis();
        tone(BUZZER_PIN, 800, 80);
      }

      leftPressActive = false;
      leftLongPressHandled = false;
    }
  }

  // Draw Yoga 1/2/3.
  //
  // The original file only supplied an animated frame sequence for
  // Yoga 1. Until separate Yoga 2/3 display logic is added, use the
  // same safe screen behavior instead of showing an uninitialized
  // buffer.
  if (yoga_current_screen == 1) {

    if (millis() - lastFrameTime >= FRAME_INTERVAL) {
      lastFrameTime = millis();
      currentFrame = !currentFrame;
    }

    drawYoga1();
  }
  if (yoga_current_screen == 2) {

    if (millis() - lastFrameTime >= FRAME_INTERVAL) {
      lastFrameTime = millis();
      currentFrame = !currentFrame;
    }

    drawYoga2();
  }
    if (yoga_current_screen == 3) {

    if (millis() - lastFrameTime >= FRAME_INTERVAL) {
      lastFrameTime = millis();
      currentFrame = !currentFrame;
    }

    drawYoga3();
  }
}

// -------------------- EMERGENCY --------------------

void sendTelegramMessage() {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x12_tf);
  u8g2.drawStr(0, 20, "Sending...");
  u8g2.sendBuffer();

  Serial.println("Sending Telegram message:");
  Serial.println(messages[selected]);

  bool result = false;

  if (WiFi.status() == WL_CONNECTED) {
    result = bot.sendMessage(
      CHANNEL_ID,
      messages[selected],
      ""
    );
  }

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x12_tf);

  if (result) {
    Serial.println("Message sent!");
    u8g2.drawStr(0, 20, "Message sent!");
  }
  else {
    Serial.println("Message failed!");
    u8g2.drawStr(0, 20, "Send failed!");
  }

  u8g2.sendBuffer();
  delay(1500);

  drawEmergencyScreen();
}

void handleEmergency() {

  // UP - previous message
  if (digitalRead(BUTTON_UP_PIN) == LOW &&
      eg_button_up_clicked == 0 &&
      millis() - lastButtonTime >= debounceTime) {

    eg_button_up_clicked = 1;
    lastButtonTime = millis();

    selected--;
    if (selected < 0) {
      selected = messageCount - 1;
    }

    tone(BUZZER_PIN, 880, 50);
  }

  if (digitalRead(BUTTON_UP_PIN) == HIGH) {
    eg_button_up_clicked = 0;
  }

  // DOWN - next message
  if (digitalRead(BUTTON_DOWN_PIN) == LOW &&
      eg_button_down_clicked == 0 &&
      millis() - lastButtonTime >= debounceTime) {

    eg_button_down_clicked = 1;
    lastButtonTime = millis();

    selected++;
    if (selected >= messageCount) {
      selected = 0;
    }

    tone(BUZZER_PIN, 440, 50);
  }

  if (digitalRead(BUTTON_DOWN_PIN) == HIGH) {
    eg_button_down_clicked = 0;
  }

  // SELECT - send exactly once per press
  if (digitalRead(BUTTON_SELECT_PIN) == LOW &&
      eg_button_select_clicked == 0 &&
      millis() - lastButtonTime >= debounceTime) {

    eg_button_select_clicked = 1;
    lastButtonTime = millis();

    tone(BUZZER_PIN, 1200, 150);
    sendTelegramMessage();
  }

  if (digitalRead(BUTTON_SELECT_PIN) == HIGH) {
    eg_button_select_clicked = 0;
  }

  // LEFT - return to main menu
  if (digitalRead(BUTTON_LEFT_PIN) == LOW &&
      button_left_clicked == 0) {

    button_left_clicked = 1;
    current_screen = 0;
    yoga_current_screen = 0;
    resetInputFlags();

    tone(BUZZER_PIN, 800, 80);
    return;
  }

  if (digitalRead(BUTTON_LEFT_PIN) == HIGH) {
    button_left_clicked = 0;
  }

  drawEmergencyScreen();
}

// -------------------- LOOP --------------------

void loop() {

  if (current_screen == 0) {
    handleMainMenu();
  }
  else if (current_screen == 1) {
    handleGameMenu();
  }
  else if (current_screen == 2) {
    handleYogaMenu();
  }
  else if (current_screen == 3) {
    handleEmergency();
  }
}
